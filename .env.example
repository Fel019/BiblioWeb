# Copiar este archivo como .env solo para herramientas locales.
# En Apache/Nginx de pruebas y producción, inyectar estas variables desde la
# configuración del servidor; nunca subir .env al repositorio.

# development | testing | production
APP_ENV=development

DB_HOST=127.0.0.1
DB_NAME=biblioweb
DB_USER=biblioweb_app
DB_PASSWORD=CAMBIAR_POR_UN_SECRETO
